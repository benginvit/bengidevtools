@page "/testfall"
@inject ITestCaseService Svc
@inject ITestDataService DataSvc
@inject ISettingsService Settings
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="testfall-page">

    <!-- ── Toolbar ── -->
    <div class="apps-toolbar" style="margin-bottom:8px">
        <input class="input" style="width:220px" placeholder="🔍 Sök..." @bind="_filter" @bind:event="oninput" />
        <button class="btn primary" @onclick="StartNew">+ Nytt</button>
        <button class="btn primary" @onclick="RunSelected"
                disabled="@(_busy || _checked.Count == 0)">
            ▶ Kör (@_checked.Count)
        </button>
        @if (_busy)
        {
            <button class="btn danger" @onclick="StopRun">⏹ Avbryt</button>
        }
        <button class="btn" @onclick="ExportSelected"
                disabled="@(_checked.Count == 0)" title="Kopiera SQL till urklipp">
            ↓ SQL (@_checked.Count)
        </button>
        <button class="btn" @onclick="ExportJson"
                disabled="@(_checked.Count == 0)" title="Ladda ner testfall som JSON-fil">
            ↓ JSON (@_checked.Count)
        </button>
        <button class="btn" @onclick="ToggleImport">
            ↑ Importera
        </button>
        <button class="btn @(_debugOpen ? "active" : "")" @onclick="ToggleMonitor" title="SQL Monitor">🔍 Monitor</button>
        <button class="btn" @onclick="CheckAll">Välj alla</button>
        <button class="btn" @onclick="ClearChecked">Rensa val</button>
        <span style="margin-left:auto;color:var(--muted);font-size:11px;align-self:center">
            @Filtered.Count() testfall
        </span>
    </div>

    @if (_importMode)
    {
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:4px;padding:10px 12px;margin-bottom:8px">
            <div style="font-size:12px;font-weight:600;color:var(--blue);margin-bottom:6px">Importera testfall (JSON)</div>
            <textarea class="debug-sql-editor" style="height:120px;resize:vertical"
                      placeholder="Klistra in JSON-array med testfall..."
                      @bind="_importText" @bind:event="oninput" />
            <div style="display:flex;gap:6px;margin-top:6px;align-items:center">
                <button class="btn sm primary" @onclick="ImportJson" disabled="@string.IsNullOrWhiteSpace(_importText)">Importera</button>
                <button class="btn sm" @onclick="CloseImport">Avbryt</button>
                @if (!string.IsNullOrEmpty(_importMsg))
                {
                    <span style="font-size:11px;color:var(--muted)">@_importMsg</span>
                }
            </div>
        </div>
    }

    <div class="testfall-layout">

        <!-- ── Col 1 (left): Toolbox ── -->
        <div class="testfall-toolbox">
            @if (DataSvc.Rows.Any())
            {
                <div class="toolbox-section-header" @onclick="() => _tbDataExpanded = !_tbDataExpanded" style="cursor:pointer">
                    <span style="flex:1">Testfallsdata</span>
                    <span style="font-size:10px">@(_tbDataExpanded ? "▾" : "▸")</span>
                </div>
                @if (_tbDataExpanded)
                {
                    <div style="padding:4px 6px">
                        <input class="input" style="font-size:11px" placeholder="Sök id eller namn..."
                               @bind="_tbDataFilter" @bind:event="oninput" />
                    </div>
                    @if (_tbDataChecked.Count > 0 && _editMode)
                    {
                        <div style="padding:2px 6px 4px">
                            <button class="btn primary sm" style="width:100%;font-size:11px"
                                    @onclick="AddCheckedDataRowsStep">
                                Lägg till (@_tbDataChecked.Count) som ett steg
                            </button>
                        </div>
                    }
                    @foreach (var row in DataSvc.Rows
                        .Where(r => string.IsNullOrEmpty(_tbDataFilter)
                            || r.DataSetId.ToString().Contains(_tbDataFilter)
                            || r.Databeskrivning.Contains(_tbDataFilter, StringComparison.OrdinalIgnoreCase))
                        .OrderBy(r => r.DataSetId))
                    {
                        var isChecked = _tbDataChecked.Contains(row.DataSetId);
                        <div class="toolbox-item @(_editMode ? (isChecked ? "toolbox-item-checked" : "") : "toolbox-item-disabled")"
                             @onclick="() => { if (_editMode) ToggleTbDataItem(row.DataSetId); }">
                            <span class="toolbox-item-check">@(isChecked ? "✓" : "")</span>
                            <span class="action-type-badge data">DATA</span>
                            <span class="toolbox-item-name">#@row.DataSetId @row.Databeskrivning</span>
                        </div>
                    }
                }
            }
            @if (_toolboxScripts.Any())
            {
                <div class="toolbox-section-header" style="margin-top:8px;cursor:pointer"
                     @onclick="() => _tbSqlExpanded = !_tbSqlExpanded">
                    <span style="flex:1">SQL-skript</span>
                    <span style="font-size:10px">@(_tbSqlExpanded ? "▾" : "▸")</span>
                </div>
                @if (_tbSqlExpanded)
                {
                    @foreach (var s in _toolboxScripts)
                    {
                        <div class="toolbox-item @(_editMode ? "" : "toolbox-item-disabled")"
                             @onclick="() => { if (_editMode) AddScriptStep(s); }"
                             title="@s.RelativePath">
                            <span class="action-type-badge sql">SQL</span>
                            <span class="toolbox-item-name">@s.Name</span>
                        </div>
                    }
                }
            }
            <div class="toolbox-section-header" style="margin-top:8px;cursor:pointer"
                 @onclick="() => _tbApiExpanded = !_tbApiExpanded">
                <span style="flex:1">API-anrop</span>
                <span style="font-size:10px">@(_tbApiExpanded ? "▾" : "▸")</span>
            </div>
            @if (_tbApiExpanded)
            {
                @if (_toolboxScenarios.Count == 0)
                {
                    <div style="padding:4px 8px;font-size:11px;color:var(--muted)">Inga mallar — spara ett steg som mall.</div>
                }
                @foreach (var s in _toolboxScenarios)
                {
                    <div class="toolbox-item @(_editMode ? "" : "toolbox-item-disabled")"
                         @onclick="() => { if (_editMode) AddScenarioStep(s); }"
                         title="@s.Data.Url">
                        <span class="action-type-badge swagger">@s.Data.Method</span>
                        <span class="toolbox-item-name">@s.Data.Name</span>
                        <button class="toolbox-delete-btn" title="Ta bort mall"
                                @onclick:stopPropagation
                                @onclick="() => DeleteScenario(s)">×</button>
                    </div>
                }
            }
            <div class="toolbox-section-header" style="margin-top:8px">Övrigt</div>
            <div class="toolbox-item @(_editMode ? "" : "toolbox-item-disabled")"
                 @onclick="() => { if (_editMode) AddBlankSqlStep(); }">
                <span class="action-type-badge sql">SQL</span>
                <span class="toolbox-item-name">Tomt SQL-steg</span>
            </div>
            <div class="toolbox-item @(_editMode ? "" : "toolbox-item-disabled")"
                 @onclick="() => { if (_editMode) AddBlankSwaggerStep(); }">
                <span class="action-type-badge swagger">HTTP</span>
                <span class="toolbox-item-name">Tomt API-anrop</span>
            </div>
            <div class="toolbox-item @(_editMode ? "" : "toolbox-item-disabled")"
                 @onclick="() => { if (_editMode) AddSqlForeachStep(); }">
                <span class="action-type-badge foreach">FOR</span>
                <span class="toolbox-item-name">SQL → foreach HTTP</span>
            </div>
            <div class="toolbox-item @(_editMode ? "" : "toolbox-item-disabled")"
                 @onclick="() => { if (_editMode) AddSqlPollStep(); }">
                <span class="action-type-badge poll">POLL</span>
                <span class="toolbox-item-name">SQL Poll</span>
            </div>
            <div class="toolbox-item @(_editMode ? "" : "toolbox-item-disabled")"
                 @onclick="() => { if (_editMode) AddSleepStep(); }">
                <span class="action-type-badge sleep">ZZZ</span>
                <span class="toolbox-item-name">Paus</span>
                <input class="input" type="number" style="width:44px;text-align:center;padding:1px 4px"
                       min="1" max="300"
                       @bind="_sleepSeconds" @bind:event="oninput"
                       @onclick:stopPropagation />
                <span style="font-size:10px;color:var(--muted)">s</span>
            </div>
            @if (!_editMode)
            {
                <div class="toolbox-hint">Välj ett testfall och klicka Redigera för att lägga till steg.</div>
            }
        </div>

        <!-- ── Col 2 (right): Editor / view ── -->
        <div class="testfall-editor">
            @if (_editMode)
            {
                <div class="testfall-form-container">
                    <div class="testfall-form-header">
                        <span style="font-weight:600;color:var(--blue)">@(_isNew ? "Nytt testfall" : "Redigera")</span>
                        <div style="display:flex;gap:6px">
                            <button class="btn sm primary" @onclick="SaveForm">Spara</button>
                            <button class="btn sm" @onclick="CancelEdit">Avbryt</button>
                        </div>
                    </div>
                    <div class="testfall-form-body">
                        <div class="form-row">
                            <div class="form-group" style="width:120px">
                                <label class="form-label">Tag (kategori)</label>
                                <input class="input" @bind="_form.Tag" @bind:event="oninput" placeholder="t.ex. EM, AM, Igun" />
                            </div>
                            <div class="form-group" style="flex:1">
                                <label class="form-label">Beskrivning</label>
                                <input class="input" @bind="_form.Beskrivning" @bind:event="oninput" />
                            </div>
                        </div>

                        <div class="section-header">Steg</div>
                        @for (int i = 0; i < _form.Steps.Count; i++)
                        {
                            var step     = _form.Steps[i];
                            var idx      = i;
                            var expanded = _expandedSteps.Contains(idx);
                            var canExpand = step.Type is TestCaseStepType.Sql
                                                      or TestCaseStepType.Swagger
                                                      or TestCaseStepType.SqlForeach
                                                      or TestCaseStepType.SqlPoll;
                            <div class="action-item">
                                <div class="action-header">
                                    @if (canExpand)
                                    {
                                        <button class="btn sm" style="padding:0 5px;min-width:20px;font-size:11px"
                                                @onclick="() => ToggleExpand(idx)">@(expanded ? "▾" : "▸")</button>
                                    }
                                    <span class="action-type-badge @StepBadgeClass(step.Type)">@StepBadgeText(step.Type)</span>
                                    <input class="input step-label-input" placeholder="Beskrivning..."
                                           @bind="step.Label" @bind:event="oninput"
                                           @onclick:stopPropagation />
                                    @if (step.Type == TestCaseStepType.Sleep)
                                    {
                                        <input class="input" type="number" style="width:58px;text-align:center;flex-shrink:0"
                                               min="1" max="300"
                                               @bind="step.SleepSeconds" @bind:event="oninput" />
                                        <span style="font-size:11px;color:var(--muted);flex-shrink:0">s</span>
                                    }
                                    <button class="btn sm" @onclick="() => MoveStepUp(idx)"   disabled="@(idx == 0)">↑</button>
                                    <button class="btn sm" @onclick="() => MoveStepDown(idx)" disabled="@(idx == _form.Steps.Count - 1)">↓</button>
                                    <button class="btn sm danger" @onclick="() => RemoveStep(idx)">×</button>
                                </div>
                                @if (expanded)
                                {
                                    <div class="step-expand-body">
                                        @if (step.Type == TestCaseStepType.Sql)
                                        {
                                            <textarea class="debug-sql-editor" style="height:300px;resize:vertical"
                                                      placeholder="SQL-skript..." spellcheck="false"
                                                      @bind="step.SqlScript" @bind:event="oninput" />
                                        }
                                        else if (step.Type == TestCaseStepType.Swagger)
                                        {
                                            <div style="display:flex;gap:6px">
                                                <select class="input" style="width:90px;flex-shrink:0" @bind="step.HttpMethod">
                                                    <option>GET</option><option>POST</option><option>PUT</option><option>DELETE</option>
                                                </select>
                                                <input class="input" placeholder="URL..." @bind="step.Url" @bind:event="oninput" />
                                            </div>
                                            <div style="display:flex;gap:8px;align-items:center">
                                                <input class="input" style="flex:1;font-size:11px" placeholder="Content-Type" @bind="step.ContentType" @bind:event="oninput" />
                                                <label style="display:flex;gap:4px;align-items:center;font-size:11px;white-space:nowrap;cursor:pointer">
                                                    <input type="checkbox" @bind="step.UseDefaultCredentials" /> UseDefaultCredentials
                                                </label>
                                            </div>
                                            <textarea class="debug-sql-editor" style="height:52px;resize:vertical;font-family:monospace"
                                                      placeholder="Headers (en per rad): X-Requested-With: XMLHttpRequest" spellcheck="false"
                                                      @bind="step.HeadersRaw" @bind:event="oninput" />
                                            <textarea class="debug-sql-editor" style="height:160px;resize:vertical"
                                                      placeholder="Body (JSON)..." spellcheck="false"
                                                      @bind="step.Body" @bind:event="oninput" />
                                            <div style="display:flex;justify-content:flex-end">
                                                <button class="btn sm" @onclick="() => SaveStepAsTemplate(step)" title="Spara som mall i verktygslådan">
                                                    💾 Spara som mall
                                                </button>
                                            </div>
                                        }
                                        else if (step.Type == TestCaseStepType.SqlForeach)
                                        {
                                            <div class="step-expand-label">SQL-fråga</div>
                                            <textarea class="debug-sql-editor" style="height:220px;resize:vertical"
                                                      placeholder="SELECT Id, JsonData FROM ..." spellcheck="false"
                                                      @bind="step.SqlScript" @bind:event="oninput" />
                                            <div class="step-expand-label">HTTP per rad — använd {KolumnNamn} i URL/body</div>
                                            <div style="display:flex;gap:6px">
                                                <select class="input" style="width:90px;flex-shrink:0" @bind="step.HttpMethod">
                                                    <option>GET</option><option>POST</option><option>PUT</option><option>DELETE</option>
                                                </select>
                                                <input class="input" placeholder="https://…/{Id}" @bind="step.Url" @bind:event="oninput" />
                                            </div>
                                            <div style="display:flex;gap:8px;align-items:center">
                                                <input class="input" style="flex:1;font-size:11px" placeholder="Content-Type" @bind="step.ContentType" @bind:event="oninput" />
                                                <label style="display:flex;gap:4px;align-items:center;font-size:11px;white-space:nowrap;cursor:pointer">
                                                    <input type="checkbox" @bind="step.UseDefaultCredentials" /> UseDefaultCredentials
                                                </label>
                                            </div>
                                            <textarea class="debug-sql-editor" style="height:52px;resize:vertical;font-family:monospace"
                                                      placeholder="Headers (en per rad): X-Requested-With: XMLHttpRequest" spellcheck="false"
                                                      @bind="step.HeadersRaw" @bind:event="oninput" />
                                            <textarea class="debug-sql-editor" style="height:160px;resize:vertical"
                                                      placeholder="Body, t.ex. {JsonData}" spellcheck="false"
                                                      @bind="step.Body" @bind:event="oninput" />
                                        }
                                        else if (step.Type == TestCaseStepType.SqlPoll)
                                        {
                                            <div class="step-expand-label">SQL-fråga (körs varje sekund)</div>
                                            <textarea class="debug-sql-editor" style="height:160px;resize:vertical"
                                                      placeholder="SELECT COUNT(*) AS Antal FROM ..." spellcheck="false"
                                                      @bind="step.SqlScript" @bind:event="oninput" />
                                            <div class="step-expand-label">Villkor för att fortsätta</div>
                                            <div style="display:flex;gap:6px;align-items:center">
                                                <select class="input" style="flex:1" @bind="step.PollCriteria">
                                                    <option value="RowCountGte">Antal rader ≥</option>
                                                    <option value="RowCountEq">Antal rader =</option>
                                                    <option value="ColumnEquals">Kolumn =</option>
                                                </select>
                                                @if (step.PollCriteria == "ColumnEquals")
                                                {
                                                    <input class="input" style="flex:1" placeholder="Kolumnnamn"
                                                           @bind="step.PollCriteriaColumn" @bind:event="oninput" />
                                                    <span style="color:var(--muted);font-size:11px">=</span>
                                                }
                                                <input class="input" style="width:70px" placeholder="Värde"
                                                       @bind="step.PollCriteriaValue" @bind:event="oninput" />
                                            </div>
                                            <div style="display:flex;gap:6px;align-items:center;margin-top:4px">
                                                <span style="font-size:11px;color:var(--muted)">Timeout</span>
                                                <input class="input" type="number" style="width:64px" min="1" max="3600"
                                                       @bind="step.PollTimeoutSeconds" />
                                                <span style="font-size:11px;color:var(--muted)">s</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (_form.Steps.Count == 0)
                        {
                            <div style="color:var(--muted);font-size:11px;padding:4px 0">Inga steg — klicka ett objekt i verktygslådan till höger.</div>
                        }
                    </div>
                </div>
            }
            else if (_selected is not null)
            {
                <div class="testfall-form-header">
                    <div>
                        @if (!string.IsNullOrEmpty(_selected.Tag))
                        {
                            <span class="testfall-tag">@_selected.Tag</span>
                        }
                        <div style="font-size:12px;margin-top:2px;font-weight:600">@_selected.Beskrivning</div>
                    </div>
                    <div style="display:flex;gap:6px;align-items:center">
                        @if (_busy)
                        {
                            <button class="btn sm danger" @onclick="StopRun">⏹ Avbryt</button>
                        }
                        else
                        {
                            <button class="btn sm primary" @onclick="() => RunOne(_selected)">▶ Kör</button>
                            <button class="btn sm" @onclick="EditSelected">✎ Redigera</button>
                            <button class="btn sm" @onclick="CopySelected" title="Skapa kopia av detta testfall">Kopiera</button>
                            <button class="btn sm danger" @onclick="DeleteSelected">🗑</button>
                        }
                    </div>
                </div>
                @if (_paused)
                {
                    <div style="display:flex;gap:8px;align-items:center;padding:6px 12px;background:#1a1200;border-bottom:1px solid #554400">
                        <span style="color:#ffcc44;font-size:11px">⏸ Pausad vid breakpoint</span>
                        <button class="btn sm primary" @onclick="ResumeBreakpoint">▶ Fortsätt</button>
                        <button class="btn sm danger"  @onclick="CancelBreakpoint">⏹ Avbryt</button>
                    </div>
                }
                <div style="flex:1;min-height:0;overflow-y:auto;padding:10px 12px">
                    @if (_selected.Steps.Count > 0)
                    {
                        @for (int i = 0; i < _selected.Steps.Count; i++)
                        {
                            var step     = _selected.Steps[i];
                            var num      = i + 1;
                            var isActive = _activeCase == _selected && _activeStepIdx == i;
                            <div style="display:flex;align-items:center;gap:6px;padding:5px 0;
                                        border-bottom:1px solid var(--border);
                                        @(isActive ? "background:color-mix(in srgb,var(--blue) 10%,transparent);border-left:2px solid var(--blue);padding-left:4px;margin-left:-2px;" : "border-left:2px solid transparent;padding-left:4px;margin-left:-2px;")">
                                <button class="breakpoint-btn @(step.Breakpoint ? "active" : "")"
                                        title="@(step.Breakpoint ? "Ta bort breakpoint" : "Lägg till breakpoint")"
                                        @onclick="() => step.Breakpoint = !step.Breakpoint">●</button>
                                @if (isActive)
                                {
                                    <span style="color:var(--blue);font-size:12px;flex-shrink:0;line-height:1">▶</span>
                                }
                                else
                                {
                                    <span style="color:var(--muted);font-size:10px;min-width:18px;text-align:right;flex-shrink:0">@num.</span>
                                }
                                <span class="action-type-badge @StepBadgeClass(step.Type)">@StepBadgeText(step.Type)</span>
                                <span style="font-size:11px;flex:1">@StepSummary(step)</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="color:var(--muted);font-size:12px">Inga steg definierade.</div>
                    }
                </div>
            }
            else
            {
                <div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--muted);font-size:12px">
                    Välj ett testfall i listan eller klicka + Nytt
                </div>
            }
        </div>

        <!-- ── Col 3 (right): Test case list ── -->
        <div class="testfall-list">
            @foreach (var tc in Filtered)
            {
                var isSelected = _selected == tc;
                <div class="testfall-row @(isSelected ? "testfall-row-selected" : "")"
                     @onclick="() => Select(tc)">
                    <input type="checkbox" checked="@_checked.Contains(tc.DataSetId)"
                           style="accent-color:var(--blue);flex-shrink:0"
                           @onclick:stopPropagation
                           @onchange="e => Toggle(tc.DataSetId, (bool)(e.Value ?? false))" />
                    @if (!string.IsNullOrEmpty(tc.Tag))
                    {
                        <span class="testfall-tag">@tc.Tag</span>
                    }
                    <span class="testfall-name">@tc.Beskrivning</span>
                </div>
            }
            @if (!Filtered.Any())
            {
                <div style="padding:12px;color:var(--muted);font-size:12px">
                    @(Svc.Cases.Count == 0 ? "Inga testfall — klicka + Nytt för att lägga till." : "Inga träffar.")
                </div>
            }
        </div>

    </div>

    <!-- ── SQL Monitor (full-screen overlay) ── -->
    @if (_debugOpen)
    {
        <div class="sql-monitor">
            <div class="sql-monitor-header">
                <span style="font-weight:600;font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em">SQL Monitor</span>
                <select class="input" style="font-size:11px;max-width:200px" @onchange="LoadMonitorScript">
                    <option value="">-- Ladda skript --</option>
                    @foreach (var s in _toolboxScripts)
                    {
                        <option value="@s.Path">@s.Name</option>
                    }
                </select>
                <button class="btn sm primary" @onclick="() => _ = RunMonitorAsync()"
                        disabled="@(_monitorRunning || string.IsNullOrWhiteSpace(_monitorSql))">
                    @(_monitorRunning ? "⟳" : "▶") Kör
                </button>
                <select class="input" style="width:62px;font-size:11px" @bind="_monitorPollSeconds">
                    <option value="1">1 s</option>
                    <option value="2">2 s</option>
                    <option value="5">5 s</option>
                    <option value="10">10 s</option>
                    <option value="30">30 s</option>
                    <option value="60">60 s</option>
                </select>
                <button class="btn sm @(_monitorPolling ? "danger" : "")" @onclick="ToggleMonitorPoll"
                        disabled="@string.IsNullOrWhiteSpace(_monitorSql)">
                    @(_monitorPolling ? "⏹ Stoppa" : "⟳ Polla")
                </button>
                @if (_monitorLastRun.HasValue)
                {
                    <span style="font-size:11px;color:var(--muted)">
                        @_monitorLastRun.Value.ToString("HH:mm:ss")
                        @{ var totalRows = _monitorResults.Sum(r => r.Rows.Count); }
                        @if (totalRows > 0) { <span> · @totalRows rad@(totalRows == 1 ? "" : "er")@(_monitorResults.Count > 1 ? $" ({_monitorResults.Count} sets)" : "")</span> }
                    </span>
                }
                <span style="flex:1"></span>
                <button class="btn sm" @onclick="() => { _debugOpen = false; _monitorPolling = false; _monitorCts?.Cancel(); }">✕ Stäng</button>
            </div>
            <div class="sql-monitor-body">
                <div class="sql-monitor-sql">
                    <textarea class="debug-sql-editor" style="flex:1;resize:none;font-size:12px;border:none;border-radius:0"
                              placeholder="SELECT ..." spellcheck="false"
                              @bind="_monitorSql" @bind:event="oninput" />
                </div>
                <div class="sql-monitor-results">
                    @if (_monitorError is not null)
                    {
                        <div style="color:var(--red);font-size:12px;padding:10px 14px">FEL: @_monitorError</div>
                    }
                    else if (_monitorResults.Count > 0)
                    {
                        <div class="sql-monitor-cols">
                            @foreach (var col in MonitorAllCols)
                            {
                                var hidden = _monitorHiddenCols.Contains(col);
                                <button class="col-pill @(hidden ? "col-pill-hidden" : "")"
                                        @onclick="() => ToggleMonitorCol(col)">@col</button>
                            }
                        </div>
                        <div class="sql-monitor-table-wrap">
                            @for (int si = 0; si < _monitorResults.Count; si++)
                            {
                                var rs      = _monitorResults[si];
                                var visCols = rs.Cols.Where(c => !_monitorHiddenCols.Contains(c)).ToList();
                                @if (_monitorResults.Count > 1)
                                {
                                    <div style="font-size:11px;color:var(--muted);padding:4px 10px;background:var(--surface);border-bottom:1px solid var(--border)">
                                        Resultat @(si + 1) — @rs.Rows.Count rad@(rs.Rows.Count == 1 ? "" : "er")
                                    </div>
                                }
                                <table class="monitor-table">
                                    <thead><tr>@foreach (var col in visCols) { <th>@col</th> }</tr></thead>
                                    <tbody>
                                        @foreach (var row in rs.Rows)
                                        {
                                            <tr class="@MonitorRowClass(row)">
                                                @foreach (var col in visCols)
                                                {
                                                    <td title="@row.GetValueOrDefault(col, "")">@row.GetValueOrDefault(col, "")</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    }
                    else if (!_monitorRunning)
                    {
                        <div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--muted);font-size:13px">
                            Skriv en SQL-fråga och kör, eller starta polling
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ── Status log ── -->
    @if (_log.Count > 0)
    {
        <div class="status-bar">
            <div class="status-bar-header">
                <span class="status-bar-title">
                    @if (_busy) { <span class="status-spinner">⟳</span> }
                    Körning
                </span>
                <button class="btn sm" @onclick="() => _log.Clear()">✕</button>
            </div>
            <div class="status-bar-log" id="testfall-log">
                @foreach (var line in _log.AsEnumerable().Reverse())
                {
                    <div style="color:@LogColor(line)">@line</div>
                }
            </div>
        </div>
    }

</div>

@code {
    private record ToolboxScript(string Name, string RelativePath, string Path);
    private record ToolboxScenario(Scenario Data, string FilePath);

    private string       _filter       = "";
    private HashSet<int> _checked      = [];
    private TestCase?    _selected;
    private bool         _editMode;
    private bool         _isNew;
    private bool         _busy;
    private TestCase     _form         = new();
    private List<string> _log          = [];
    private int          _sleepSeconds = 2;
    private readonly CancellationTokenSource _cts    = new(); // component lifetime
    private CancellationTokenSource?          _runCts;        // per-run

    private List<ToolboxScript>   _toolboxScripts   = [];
    private List<ToolboxScenario> _toolboxScenarios = [];
    private HashSet<int>        _expandedSteps    = [];
    private bool                          _paused           = false;
    private TaskCompletionSource<bool>?  _breakpointTcs;
    private bool                _tbDataExpanded   = false;
    private string              _tbDataFilter     = "";
    private HashSet<int>        _tbDataChecked    = [];
    private bool                _tbSqlExpanded    = false;
    private bool                _tbApiExpanded    = false;
    private bool                _importMode       = false;
    private string              _importText       = "";
    private string              _importMsg        = "";

    private TestCase?                _activeCase;
    private int                      _activeStepIdx      = -1;

    private bool                     _debugOpen          = false;
    private string                   _monitorSql         = "";
    private int                      _monitorPollSeconds = 5;
    private bool                     _monitorPolling     = false;
    private bool                     _monitorRunning     = false;
    private CancellationTokenSource? _monitorCts;
    private List<(List<string> Cols, List<Dictionary<string,string>> Rows)> _monitorResults   = [];
    private HashSet<string>                                                _monitorHiddenCols = [];
    private IEnumerable<string> MonitorAllCols => _monitorResults.SelectMany(r => r.Cols).Distinct(StringComparer.OrdinalIgnoreCase);
    private string?                  _monitorError;
    private DateTime?                _monitorLastRun;

    private IEnumerable<TestCase> Filtered => Svc.Cases
        .Where(tc => string.IsNullOrEmpty(_filter)
            || tc.Beskrivning.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || tc.Tag.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || tc.DataSetId.ToString().Contains(_filter))
        .OrderBy(tc => tc.DataSetId);

    protected override void OnInitialized() { Svc.Load(); DataSvc.Load(); LoadToolbox(); }

    private void ToggleMonitor() => _debugOpen = !_debugOpen;

    public async ValueTask DisposeAsync() { _runCts?.Cancel(); _monitorCts?.Cancel(); _cts.Cancel(); await Task.CompletedTask; }

    // ── Toolbox ────────────────────────────────────────────────────────────────

    private void LoadToolbox()
    {
        var root = Settings.Settings.DebugScriptsPath;
        if (!Directory.Exists(root)) return;

        _toolboxScripts = Directory.GetFiles(root, "*.sql", SearchOption.AllDirectories)
            .OrderBy(f => f)
            .Select(f => new ToolboxScript(
                Name:         Path.GetFileNameWithoutExtension(f),
                RelativePath: Path.GetRelativePath(root, f),
                Path:         f))
            .ToList();

        var scenariosDir = Path.Combine(root, "scenarios");
        if (Directory.Exists(scenariosDir))
        {
            _toolboxScenarios = Directory.GetFiles(scenariosDir, "*.json")
                .OrderBy(f => f)
                .Select(f =>
                {
                    try
                    {
                        var s = System.Text.Json.JsonSerializer.Deserialize<Scenario>(File.ReadAllText(f));
                        return s is null ? null : new ToolboxScenario(s, f);
                    }
                    catch { return null; }
                })
                .Where(x => x is not null)
                .Cast<ToolboxScenario>()
                .ToList();
        }
    }

    private void ToggleExpand(int idx)
    {
        if (!_expandedSteps.Remove(idx)) _expandedSteps.Add(idx);
    }

    private void AddDataRowStep(int dataSetId, string beskrivning)
    {
        var sql = DataSvc.GenerateSql([dataSetId]);
        _form.Steps.Add(new TestCaseStep {
            Type      = TestCaseStepType.Sql,
            Label     = $"Testdata #{dataSetId} {beskrivning}",
            SqlScript = sql,
        });
        _expandedSteps.Add(_form.Steps.Count - 1);
    }

    private void ToggleTbDataItem(int dataSetId)
    {
        if (!_tbDataChecked.Remove(dataSetId))
            _tbDataChecked.Add(dataSetId);
    }

    private void AddCheckedDataRowsStep()
    {
        var ids  = _tbDataChecked.OrderBy(x => x).ToList();
        var rows = DataSvc.Rows.Where(r => ids.Contains(r.DataSetId)).OrderBy(r => r.DataSetId).ToList();
        var label = rows.Count == 1
            ? $"Testdata #{rows[0].DataSetId} {rows[0].Databeskrivning}"
            : $"Testdata ({rows.Count}): " + string.Join(", ", rows.Select(r => $"#{r.DataSetId}"));
        _form.Steps.Add(new TestCaseStep {
            Type      = TestCaseStepType.Sql,
            Label     = label,
            SqlScript = DataSvc.GenerateSql(ids),
        });
        _expandedSteps.Add(_form.Steps.Count - 1);
        _tbDataChecked.Clear();
    }

    private void AddBlankSqlStep()
    {
        _form.Steps.Add(new TestCaseStep { Type = TestCaseStepType.Sql, Label = "SQL" });
        _expandedSteps.Add(_form.Steps.Count - 1);
    }

    private void AddBlankSwaggerStep()
    {
        _form.Steps.Add(new TestCaseStep { Type = TestCaseStepType.Swagger, Label = "API-anrop", HttpMethod = "POST" });
        _expandedSteps.Add(_form.Steps.Count - 1);
    }

    private void AddScriptStep(ToolboxScript script)
    {
        var content = File.Exists(script.Path) ? File.ReadAllText(script.Path) : "";
        _form.Steps.Add(new TestCaseStep { Type = TestCaseStepType.Sql, Label = script.Name, SqlScript = content });
        _expandedSteps.Add(_form.Steps.Count - 1);
    }

    private void AddScenarioStep(ToolboxScenario ts)
    {
        var s = ts.Data;
        _form.Steps.Add(new TestCaseStep {
            Type                  = TestCaseStepType.Swagger,
            Label                 = s.Name,
            HttpMethod            = s.Method,
            Url                   = s.Url,
            Body                  = s.Body,
            ContentType           = s.ContentType,
            UseDefaultCredentials = s.UseDefaultCredentials,
        });
        _expandedSteps.Add(_form.Steps.Count - 1);
    }

    private void SaveStepAsTemplate(TestCaseStep step)
    {
        var name = string.IsNullOrWhiteSpace(step.Label) ? "API-anrop" : step.Label;
        var scenario = new Scenario
        {
            Name                  = name,
            Method                = step.HttpMethod,
            Url                   = step.Url,
            Body                  = step.Body,
            ContentType           = step.ContentType,
            UseDefaultCredentials = step.UseDefaultCredentials,
        };
        var dir  = Path.Combine(Settings.Settings.DebugScriptsPath, "scenarios");
        var file = Path.Combine(dir, SanitizeFileName(name) + ".json");
        Directory.CreateDirectory(dir);
        File.WriteAllText(file, System.Text.Json.JsonSerializer.Serialize(
            scenario, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }));
        var existing = _toolboxScenarios.FindIndex(x => x.FilePath == file);
        var entry    = new ToolboxScenario(scenario, file);
        if (existing >= 0) _toolboxScenarios[existing] = entry;
        else               _toolboxScenarios.Add(entry);
        _tbApiExpanded = true;
    }

    private void DeleteScenario(ToolboxScenario ts)
    {
        if (File.Exists(ts.FilePath)) File.Delete(ts.FilePath);
        _toolboxScenarios.Remove(ts);
    }

    private static string SanitizeFileName(string name)
    {
        var invalid = Path.GetInvalidFileNameChars();
        return string.Concat(name.Select(c => invalid.Contains(c) ? '_' : c)).Trim('_');
    }

    private void AddSqlForeachStep()
    {
        _form.Steps.Add(new TestCaseStep { Type = TestCaseStepType.SqlForeach, Label = "SQL → foreach HTTP", HttpMethod = "POST" });
        _expandedSteps.Add(_form.Steps.Count - 1);
    }

    private void AddSqlPollStep()
    {
        _form.Steps.Add(new TestCaseStep { Type = TestCaseStepType.SqlPoll, Label = "SQL Poll" });
        _expandedSteps.Add(_form.Steps.Count - 1);
    }

    private void AddSleepStep() =>
        _form.Steps.Add(new TestCaseStep { Type = TestCaseStepType.Sleep, SleepSeconds = _sleepSeconds, Label = $"Vänta {_sleepSeconds}s" });

    private void RemoveStep(int idx)
    {
        _form.Steps.RemoveAt(idx);
        _expandedSteps = _expandedSteps
            .Where(i => i != idx)
            .Select(i => i > idx ? i - 1 : i)
            .ToHashSet();
    }

    private void MoveStepUp(int idx)
    {
        if (idx <= 0) return;
        (_form.Steps[idx - 1], _form.Steps[idx]) = (_form.Steps[idx], _form.Steps[idx - 1]);
        _expandedSteps.Clear();
    }

    private void MoveStepDown(int idx)
    {
        if (idx >= _form.Steps.Count - 1) return;
        (_form.Steps[idx + 1], _form.Steps[idx]) = (_form.Steps[idx], _form.Steps[idx + 1]);
        _expandedSteps.Clear();
    }

    // ── Step helpers ───────────────────────────────────────────────────────────

    private static string StepBadgeClass(TestCaseStepType t) => t switch
    {
        TestCaseStepType.TestfallData => "data",
        TestCaseStepType.Sql         => "sql",
        TestCaseStepType.Swagger     => "swagger",
        TestCaseStepType.Sleep       => "sleep",
        TestCaseStepType.SqlForeach  => "foreach",
        TestCaseStepType.SqlPoll     => "poll",
        _                            => "",
    };

    private static string StepBadgeText(TestCaseStepType t) => t switch
    {
        TestCaseStepType.TestfallData => "DATA",
        TestCaseStepType.Sql         => "SQL",
        TestCaseStepType.Swagger     => "HTTP",
        TestCaseStepType.Sleep       => "ZZZ",
        TestCaseStepType.SqlForeach  => "FOR",
        TestCaseStepType.SqlPoll     => "POLL",
        _                            => "?",
    };

    private static string StepSummary(TestCaseStep step) => step.Type switch
    {
        TestCaseStepType.TestfallData => $"#{step.DataSetId} {step.Label}",
        TestCaseStepType.Sql         => step.Label,
        TestCaseStepType.Swagger     => string.IsNullOrEmpty(step.Label) ? $"{step.HttpMethod} {step.Url}" : step.Label,
        TestCaseStepType.Sleep       => $"Vänta {step.SleepSeconds}s",
        TestCaseStepType.SqlForeach  => string.IsNullOrEmpty(step.Label) ? $"{step.HttpMethod} {step.Url}" : step.Label,
        TestCaseStepType.SqlPoll     => string.IsNullOrEmpty(step.Label) ? "SQL Poll" : step.Label,
        _                            => step.Label,
    };

    // ── Selection ──────────────────────────────────────────────────────────────

    private void Select(TestCase tc)
    {
        if (_editMode) return;
        _selected = _selected == tc ? null : tc;
    }

    private void Toggle(int id, bool on)
    {
        if (on) _checked.Add(id); else _checked.Remove(id);
    }

    private void CheckAll()     => _checked = Filtered.Select(tc => tc.DataSetId).ToHashSet();
    private void ClearChecked() => _checked.Clear();

    // ── Edit ───────────────────────────────────────────────────────────────────

    private int NextId() => Svc.Cases.Any() ? Svc.Cases.Max(c => c.DataSetId) + 1 : 1;

    private void StartNew()
    {
        _form          = new TestCase { DataSetId = NextId() };
        _isNew         = true;
        _editMode      = true;
        _selected      = null;
        _expandedSteps.Clear();
    }

    private void CopySelected()
    {
        if (_selected is null) return;
        _form = new TestCase
        {
            DataSetId   = NextId(),
            Beskrivning = _selected.Beskrivning + " (kopia)",
            Tag         = _selected.Tag,
            Steps       = _selected.Steps.Select(s => new TestCaseStep
            {
                Type                  = s.Type,
                Label                 = s.Label,
                DataSetId             = s.DataSetId,
                SqlScript             = s.SqlScript,
                HttpMethod            = s.HttpMethod,
                Url                   = s.Url,
                Body                  = s.Body,
                ContentType           = s.ContentType,
                UseDefaultCredentials = s.UseDefaultCredentials,
                HeadersRaw            = s.HeadersRaw,
                SleepSeconds          = s.SleepSeconds,
                PollCriteria          = s.PollCriteria,
                PollCriteriaColumn    = s.PollCriteriaColumn,
                PollCriteriaValue     = s.PollCriteriaValue,
                PollTimeoutSeconds    = s.PollTimeoutSeconds,
                Breakpoint            = false,
            }).ToList(),
        };
        _isNew    = true;
        _editMode = true;
        _expandedSteps.Clear();
    }

    private void EditSelected()
    {
        if (_selected is null) return;
        _form = new TestCase
        {
            DataSetId   = _selected.DataSetId,
            Beskrivning = _selected.Beskrivning,
            Tag         = _selected.Tag,
            Steps       = _selected.Steps.Select(s => new TestCaseStep
            {
                Type                  = s.Type,
                Label                 = s.Label,
                DataSetId             = s.DataSetId,
                SqlScript             = s.SqlScript,
                HttpMethod            = s.HttpMethod,
                Url                   = s.Url,
                Body                  = s.Body,
                ContentType           = s.ContentType,
                UseDefaultCredentials = s.UseDefaultCredentials,
                HeadersRaw            = s.HeadersRaw,
                SleepSeconds          = s.SleepSeconds,
                PollCriteria          = s.PollCriteria,
                PollCriteriaColumn    = s.PollCriteriaColumn,
                PollCriteriaValue     = s.PollCriteriaValue,
                PollTimeoutSeconds    = s.PollTimeoutSeconds,
                Breakpoint            = s.Breakpoint,
            }).ToList(),
        };
        _isNew    = false;
        _editMode = true;
        _expandedSteps.Clear();
    }

    private void SaveForm()
    {
        if (_isNew)
            Svc.Add(_form);
        else if (_selected is not null)
        {
            Svc.Replace(_selected, _form);
            _selected = _form;
        }
        _editMode = false;
    }

    private void CancelEdit() { _editMode = false; _expandedSteps.Clear(); }

    private async Task OnBreakpoint(TestCaseStep step, CancellationToken ct)
    {
        _breakpointTcs = new TaskCompletionSource<bool>();
        _paused = true;
        await InvokeAsync(() => { Log($"⏸ Breakpoint: {step.Label}"); StateHasChanged(); });
        using var reg = ct.Register(() => _breakpointTcs.TrySetCanceled());
        await _breakpointTcs.Task;
        _paused = false;
    }

    private void ResumeBreakpoint() { _paused = false; _breakpointTcs?.TrySetResult(true); }
    private void CancelBreakpoint()  { _paused = false; _breakpointTcs?.TrySetCanceled(); _runCts?.Cancel(); }
    private void StopRun()           { _runCts?.Cancel(); }

    private void DeleteSelected()
    {
        if (_selected is null) return;
        Svc.Remove(_selected);
        _checked.Remove(_selected.DataSetId);
        _selected = null;
    }

    // ── Run ────────────────────────────────────────────────────────────────────

    private async Task RunOne(TestCase tc)  => await Execute([tc]);
    private async Task RunSelected()        => await Execute(Filtered.Where(tc => _checked.Contains(tc.DataSetId)).ToList());

    private async Task Execute(IList<TestCase> cases)
    {
        _runCts?.Dispose();
        _runCts = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
        var ct = _runCts.Token;

        _log.Clear();
        _busy = true;
        Log($"──── Kör {cases.Count} testfall ────");
        await InvokeAsync(StateHasChanged);

        try
        {
            await Svc.RunAsync(cases, Settings.Settings.SqlConnectionString,
                msg => _ = LogAsync(msg), OnBreakpoint,
                (tc, idx) => { _activeCase = tc; _activeStepIdx = idx; _ = InvokeAsync(StateHasChanged); },
                ct);
            Log("──── Klar ─────────────────────────────");
        }
        catch (OperationCanceledException) { Log("  Avbruten"); }
        catch (Exception ex)               { Log($"  FEL: {ex.Message}"); }

        _activeCase    = null;
        _activeStepIdx = -1;
        _busy = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Log(string msg)
    {
        _log.Add(msg);
        if (_log.Count > 500) _log.RemoveAt(0);
    }

    private async Task LogAsync(string msg)
    {
        await InvokeAsync(() => { Log(msg); StateHasChanged(); });
    }

    private static string LogColor(string line)
    {
        if (line.StartsWith("────")) return "var(--muted)";
        if (line.Contains("FEL:"))  return "var(--red)";
        if (line.Contains("OK"))    return "var(--green)";
        return "var(--text)";
    }

    // ── Export / Import ────────────────────────────────────────────────────────

    private async Task ExportSelected()
    {
        var cases = Filtered.Where(tc => _checked.Contains(tc.DataSetId)).ToList();
        var sql   = Svc.ExportSql(cases);
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", sql); } catch { }
        Log($"──── Exporterade {cases.Count} testfall (SQL) till urklipp ────");
    }

    private async Task ExportJson()
    {
        var cases    = Filtered.Where(tc => _checked.Contains(tc.DataSetId)).ToList();
        var json     = System.Text.Json.JsonSerializer.Serialize(cases, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        var filename = $"testfall_{DateTime.Now:yyyyMMdd_HHmm}.json";
        await JS.InvokeVoidAsync("downloadFile", filename, json);
        Log($"──── Exporterade {cases.Count} testfall som {filename} ────");
    }

    private void ToggleImport() { _importMode = !_importMode; _importText = ""; _importMsg = ""; }
    private void CloseImport()  { _importMode = false;       _importText = ""; _importMsg = ""; }

    private void ImportJson()
    {
        if (string.IsNullOrWhiteSpace(_importText)) return;
        try
        {
            var incoming = System.Text.Json.JsonSerializer.Deserialize<List<TestCase>>(
                _importText, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? [];
            var existing = Svc.Cases.Select(c => c.DataSetId).ToHashSet();
            var toAdd    = incoming.Where(c => !existing.Contains(c.DataSetId)).ToList();
            var skipped  = incoming.Count - toAdd.Count;
            if (toAdd.Count > 0)
                Svc.AddRange(toAdd);
            _importMsg = skipped > 0
                ? $"Importerade {toAdd.Count} testfall, hoppade över {skipped} (DataSetId redan finns)."
                : $"Importerade {toAdd.Count} testfall.";
            _importText = "";
        }
        catch (Exception ex)
        {
            _importMsg = $"Fel: {ex.Message}";
        }
    }

    // ── SQL Monitor ────────────────────────────────────────────────────────────

    private void LoadMonitorScript(ChangeEventArgs e)
    {
        var path = e.Value?.ToString();
        if (!string.IsNullOrEmpty(path) && File.Exists(path))
            _monitorSql = File.ReadAllText(path);
    }

    private async Task RunMonitorAsync()
    {
        if (string.IsNullOrWhiteSpace(_monitorSql)) return;
        _monitorRunning = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            var (results, err) = await Svc.QueryAsync(_monitorSql, Settings.Settings.SqlConnectionString, _cts.Token);
            _monitorResults = results;
            _monitorError   = err;
            _monitorLastRun = DateTime.Now;
            _monitorHiddenCols.IntersectWith(MonitorAllCols.ToHashSet(StringComparer.OrdinalIgnoreCase));
        }
        catch (OperationCanceledException) { }
        _monitorRunning = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleMonitorPoll()
    {
        if (_monitorPolling) { _monitorCts?.Cancel(); }
        else                 { _ = StartMonitorPollAsync(); }
    }

    private async Task StartMonitorPollAsync()
    {
        _monitorCts?.Dispose();
        _monitorCts     = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token);
        _monitorPolling = true;
        var ct = _monitorCts.Token;
        while (!ct.IsCancellationRequested)
        {
            if (!string.IsNullOrWhiteSpace(_monitorSql))
            {
                _monitorRunning = true;
                await InvokeAsync(StateHasChanged);
                try
                {
                    var (results, err) = await Svc.QueryAsync(_monitorSql, Settings.Settings.SqlConnectionString, ct);
                    _monitorResults = results;
                    _monitorError   = err;
                    _monitorLastRun = DateTime.Now;
                    _monitorHiddenCols.IntersectWith(MonitorAllCols.ToHashSet(StringComparer.OrdinalIgnoreCase));
                }
                catch (OperationCanceledException) { break; }
                catch (Exception ex)               { _monitorError = ex.Message; }
                _monitorRunning = false;
                await InvokeAsync(StateHasChanged);
            }
            try { await Task.Delay(TimeSpan.FromSeconds(_monitorPollSeconds), ct); }
            catch (OperationCanceledException) { break; }
        }
        _monitorPolling = false;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleMonitorCol(string col)
    {
        if (!_monitorHiddenCols.Remove(col)) _monitorHiddenCols.Add(col);
    }

    private static string MonitorRowClass(Dictionary<string, string> row)
    {
        var statusKeys = new[] { "state", "status", "result", "error", "type", "tillstand" };
        var vals = row
            .Where(kv => statusKeys.Any(k => kv.Key.Contains(k, StringComparison.OrdinalIgnoreCase)))
            .Select(kv => kv.Value.ToLowerInvariant())
            .Concat(row.Values.Select(v => v.ToLowerInvariant()))
            .ToList();

        if (vals.Any(v => v is "dead" or "deadletter" or "deadlettered" or "failed" or "error"
                           or "faulted" or "suspended" or "poison" or "aborted" or "fault"))
            return "row-error";
        if (vals.Any(v => v is "active" or "completed" or "processed" or "success"
                           or "succeeded" or "ok" or "done" or "delivered"))
            return "row-ok";
        if (vals.Any(v => v is "scheduled" or "deferred" or "pending" or "waiting"
                           or "queued" or "enqueued" or "retrying"))
            return "row-warn";
        return "";
    }
}
