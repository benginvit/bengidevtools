@page "/testfall"
@inject ITestCaseService Svc
@inject ITestDataService DataSvc
@inject ISettingsService Settings
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="testfall-page">

    <!-- ── Toolbar ── -->
    <div class="apps-toolbar" style="margin-bottom:8px">
        <input class="input" style="width:220px" placeholder="🔍 Sök..." @bind="_filter" @bind:event="oninput" />
        <button class="btn primary" @onclick="StartNew">+ Nytt</button>
        <button class="btn primary" @onclick="RunSelected"
                disabled="@(_busy || _checked.Count == 0)">
            @(_busy ? "⟳" : $"▶ Kör ({_checked.Count})")
        </button>
        <button class="btn" @onclick="ExportSelected"
                disabled="@(_checked.Count == 0)" title="Kopiera SQL till urklipp">
            ↓ Exportera (@_checked.Count)
        </button>
        <button class="btn" @onclick="CheckAll">Välj alla</button>
        <button class="btn" @onclick="ClearChecked">Rensa val</button>
        <span style="margin-left:auto;color:var(--muted);font-size:11px;align-self:center">
            @Filtered.Count() testfall
        </span>
    </div>

    <div class="testfall-layout @(_editMode ? "testfall-layout-editing" : "")">

        <!-- ── Col 3 (right): Toolbox ── -->
        <div class="testfall-toolbox">
            @if (DataSvc.Rows.Count > 0)
            {
                <div class="toolbox-section-header">Testfallsdata</div>
                @foreach (var row in DataSvc.Rows.OrderBy(r => r.DataSetId))
                {
                    <div class="toolbox-item @(_editMode ? "" : "toolbox-item-disabled")"
                         @onclick="() => { if (_editMode) AddDataRowStep(row.DataSetId, row.Databeskrivning); }"
                         title="DataSetId @row.DataSetId">
                        <span class="action-type-badge data">DATA</span>
                        <span class="toolbox-item-name">#@row.DataSetId @row.Databeskrivning</span>
                    </div>
                }
            }

            <div class="toolbox-section-header">
                <span style="flex:1">SQL-skript</span>
                <button class="btn sm toolbox-add-btn" @onclick="() => { _newSqlOpen = !_newSqlOpen; _newSwagOpen = false; }"
                        title="Skapa nytt SQL-skript">+</button>
            </div>
            @if (_newSqlOpen)
            {
                <div class="toolbox-new-form">
                    <input class="input" placeholder="Namn..." @bind="_newSqlName" @bind:event="oninput" />
                    <textarea class="debug-sql-editor toolbox-new-textarea"
                              placeholder="SQL-skript..." spellcheck="false"
                              @bind="_newSqlContent" @bind:event="oninput" />
                    <div style="display:flex;gap:4px">
                        <button class="btn sm primary" @onclick="SaveNewSql"
                                disabled="@string.IsNullOrWhiteSpace(_newSqlName)">Spara</button>
                        <button class="btn sm" @onclick="CancelNewSql">Avbryt</button>
                    </div>
                </div>
            }
            @foreach (var s in _toolboxScripts)
            {
                <div class="toolbox-item @(_editMode ? "" : "toolbox-item-disabled")"
                     @onclick="() => { if (_editMode) AddScriptStep(s); }"
                     title="@s.RelativePath">
                    <span class="action-type-badge sql">SQL</span>
                    <span class="toolbox-item-name">@s.Name</span>
                    <button class="btn sm toolbox-edit-btn" title="Redigera"
                            @onclick:stopPropagation
                            @onclick="() => StartEditSql(s)">✎</button>
                </div>
                @if (_editSqlPath == s.Path)
                {
                    <div class="toolbox-new-form">
                        <input class="input" @bind="_editSqlName" @bind:event="oninput" />
                        <textarea class="debug-sql-editor toolbox-new-textarea"
                                  spellcheck="false"
                                  @bind="_editSqlContent" @bind:event="oninput" />
                        <div style="display:flex;gap:4px">
                            <button class="btn sm primary" @onclick="SaveEditSql"
                                    disabled="@string.IsNullOrWhiteSpace(_editSqlName)">Spara</button>
                            <button class="btn sm" @onclick="CancelEditSql">Avbryt</button>
                        </div>
                    </div>
                }
            }

            <div class="toolbox-section-header">
                <span style="flex:1">Swagger-anrop</span>
                <button class="btn sm toolbox-add-btn" @onclick="() => { _newSwagOpen = !_newSwagOpen; _newSqlOpen = false; }"
                        title="Skapa nytt Swagger-anrop">+</button>
            </div>
            @if (_newSwagOpen)
            {
                <div class="toolbox-new-form">
                    <input class="input" placeholder="Namn..." @bind="_newSwagName" @bind:event="oninput" />
                    <div style="display:flex;gap:4px">
                        <select class="input" style="width:76px;flex-shrink:0" @bind="_newSwagMethod">
                            <option>GET</option>
                            <option>POST</option>
                            <option>PUT</option>
                            <option>DELETE</option>
                        </select>
                        <input class="input" placeholder="URL..." @bind="_newSwagUrl" @bind:event="oninput" />
                    </div>
                    <textarea class="debug-sql-editor toolbox-new-textarea"
                              placeholder="Body (JSON)..." spellcheck="false"
                              @bind="_newSwagBody" @bind:event="oninput" />
                    <div style="display:flex;gap:4px">
                        <button class="btn sm primary" @onclick="SaveNewSwagger"
                                disabled="@(string.IsNullOrWhiteSpace(_newSwagName) || string.IsNullOrWhiteSpace(_newSwagUrl))">Spara</button>
                        <button class="btn sm" @onclick="CancelNewSwagger">Avbryt</button>
                    </div>
                </div>
            }
            @foreach (var s in _toolboxScenarios)
            {
                <div class="toolbox-item @(_editMode ? "" : "toolbox-item-disabled")"
                     @onclick="() => { if (_editMode) AddScenarioStep(s); }"
                     title="@s.Url">
                    <span class="action-type-badge swagger">@s.Method</span>
                    <span class="toolbox-item-name">@s.Name</span>
                    <button class="btn sm toolbox-edit-btn" title="Redigera"
                            @onclick:stopPropagation
                            @onclick="() => StartEditSwagger(s)">✎</button>
                </div>
                @if (_editSwagId == s.Id)
                {
                    <div class="toolbox-new-form">
                        <input class="input" placeholder="Namn..." @bind="_editSwagName" @bind:event="oninput" />
                        <div style="display:flex;gap:4px">
                            <select class="input" style="width:76px;flex-shrink:0" @bind="_editSwagMethod">
                                <option>GET</option>
                                <option>POST</option>
                                <option>PUT</option>
                                <option>DELETE</option>
                            </select>
                            <input class="input" placeholder="URL..." @bind="_editSwagUrl" @bind:event="oninput" />
                        </div>
                        <textarea class="debug-sql-editor toolbox-new-textarea"
                                  placeholder="Body (JSON)..." spellcheck="false"
                                  @bind="_editSwagBody" @bind:event="oninput" />
                        <div style="display:flex;gap:4px">
                            <button class="btn sm primary" @onclick="SaveEditSwagger"
                                    disabled="@(string.IsNullOrWhiteSpace(_editSwagName) || string.IsNullOrWhiteSpace(_editSwagUrl))">Spara</button>
                            <button class="btn sm" @onclick="CancelEditSwagger">Avbryt</button>
                        </div>
                    </div>
                }
            }

            <div class="toolbox-section-header">SQL → HTTP</div>
            <div class="toolbox-item @(_editMode ? "" : "toolbox-item-disabled")"
                 @onclick="() => { if (_editMode) AddSqlForeachStep(); }">
                <span class="action-type-badge foreach">FOR</span>
                <span class="toolbox-item-name">SQL → foreach HTTP</span>
            </div>

            <div class="toolbox-section-header">Paus</div>
            <div class="toolbox-item @(_editMode ? "" : "toolbox-item-disabled")"
                 @onclick="() => { if (_editMode) AddSleepStep(); }">
                <span class="action-type-badge sleep">ZZZ</span>
                <span class="toolbox-item-name">Vänta</span>
                <input class="input" type="number" style="width:44px;text-align:center;padding:1px 4px"
                       min="1" max="300"
                       @bind="_sleepSeconds" @bind:event="oninput"
                       @onclick:stopPropagation />
                <span style="font-size:10px;color:var(--muted)">s</span>
            </div>

            @if (!_editMode)
            {
                <div class="toolbox-hint">Redigera ett testfall för att lägga till steg.</div>
            }
        </div>

        <!-- ── Col 1 (left): Test case list ── -->
        <div class="testfall-list">
            @foreach (var tc in Filtered)
            {
                var isSelected = _selected == tc;
                <div class="testfall-row @(isSelected ? "testfall-row-selected" : "")"
                     @onclick="() => Select(tc)">
                    <input type="checkbox" checked="@_checked.Contains(tc.DataSetId)"
                           style="accent-color:var(--blue);flex-shrink:0"
                           @onclick:stopPropagation
                           @onchange="e => Toggle(tc.DataSetId, (bool)(e.Value ?? false))" />
                    <span class="testfall-id">#@tc.DataSetId</span>
                    @if (!string.IsNullOrEmpty(tc.Tag))
                    {
                        <span class="testfall-tag">@tc.Tag</span>
                    }
                    <span class="testfall-name">@tc.Beskrivning</span>
                </div>
            }
            @if (!Filtered.Any())
            {
                <div style="padding:12px;color:var(--muted);font-size:12px">
                    @(Svc.Cases.Count == 0 ? "Inga testfall — klicka + Nytt för att lägga till." : "Inga träffar.")
                </div>
            }
        </div>

        <!-- ── Col 2 (middle): Editor / view ── -->
        <div class="testfall-editor">
            @if (_editMode)
            {
                <div class="testfall-form-container">
                    <div class="testfall-form-header">
                        <span style="font-weight:600;color:var(--blue)">@(_isNew ? "Nytt testfall" : $"Redigera #{_form.DataSetId}")</span>
                        <div style="display:flex;gap:6px">
                            <button class="btn sm primary" @onclick="SaveForm">Spara</button>
                            <button class="btn sm" @onclick="CancelEdit">Avbryt</button>
                        </div>
                    </div>
                    <div class="testfall-form-body">
                        <div class="form-row">
                            <div class="form-group" style="width:120px">
                                <label class="form-label">DataSetId</label>
                                <input class="input" type="number" @bind="_form.DataSetId" />
                            </div>
                            <div class="form-group" style="flex:1">
                                <label class="form-label">Tag (kategori)</label>
                                <input class="input" @bind="_form.Tag" @bind:event="oninput" placeholder="t.ex. EM, AM, Igun" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Beskrivning</label>
                            <input class="input" @bind="_form.Beskrivning" @bind:event="oninput" />
                        </div>

                        <div class="section-header">Steg</div>
                        @for (int i = 0; i < _form.Steps.Count; i++)
                        {
                            var step     = _form.Steps[i];
                            var idx      = i;
                            var expanded = _expandedSteps.Contains(idx);
                            var canExpand = step.Type is TestCaseStepType.Sql
                                                      or TestCaseStepType.Swagger
                                                      or TestCaseStepType.SqlForeach;
                            <div class="action-item">
                                <div class="action-header">
                                    @if (canExpand)
                                    {
                                        <button class="btn sm" style="padding:0 5px;min-width:20px;font-size:11px"
                                                @onclick="() => ToggleExpand(idx)">@(expanded ? "▾" : "▸")</button>
                                    }
                                    <span class="action-type-badge @StepBadgeClass(step.Type)">@StepBadgeText(step.Type)</span>
                                    <span style="flex:1;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                        @StepSummary(step)
                                    </span>
                                    @if (step.Type == TestCaseStepType.Sleep)
                                    {
                                        <input class="input" type="number" style="width:58px;text-align:center"
                                               min="1" max="300"
                                               @bind="step.SleepSeconds" @bind:event="oninput" />
                                        <span style="font-size:11px;color:var(--muted)">s</span>
                                    }
                                    <button class="btn sm" @onclick="() => MoveStepUp(idx)"   disabled="@(idx == 0)">↑</button>
                                    <button class="btn sm" @onclick="() => MoveStepDown(idx)" disabled="@(idx == _form.Steps.Count - 1)">↓</button>
                                    <button class="btn sm danger" @onclick="() => RemoveStep(idx)">×</button>
                                </div>
                                @if (expanded)
                                {
                                    <div class="step-expand-body">
                                        <input class="input" style="font-size:11px" placeholder="Stegnamn..."
                                               @bind="step.Label" @bind:event="oninput" />
                                        @if (step.Type == TestCaseStepType.Sql)
                                        {
                                            <textarea class="debug-sql-editor" style="height:140px;resize:vertical"
                                                      placeholder="SQL-skript..." spellcheck="false"
                                                      @bind="step.SqlScript" @bind:event="oninput" />
                                        }
                                        else if (step.Type == TestCaseStepType.Swagger)
                                        {
                                            <div style="display:flex;gap:6px">
                                                <select class="input" style="width:90px;flex-shrink:0" @bind="step.HttpMethod">
                                                    <option>GET</option><option>POST</option><option>PUT</option><option>DELETE</option>
                                                </select>
                                                <input class="input" placeholder="URL..." @bind="step.Url" @bind:event="oninput" />
                                            </div>
                                            <textarea class="debug-sql-editor" style="height:80px;resize:vertical"
                                                      placeholder="Body (JSON)..." spellcheck="false"
                                                      @bind="step.Body" @bind:event="oninput" />
                                        }
                                        else if (step.Type == TestCaseStepType.SqlForeach)
                                        {
                                            <div class="step-expand-label">SQL-fråga</div>
                                            <textarea class="debug-sql-editor" style="height:110px;resize:vertical"
                                                      placeholder="SELECT Id, JsonData FROM ..." spellcheck="false"
                                                      @bind="step.SqlScript" @bind:event="oninput" />
                                            <div class="step-expand-label">HTTP per rad — använd {KolumnNamn} i URL/body</div>
                                            <div style="display:flex;gap:6px">
                                                <select class="input" style="width:90px;flex-shrink:0" @bind="step.HttpMethod">
                                                    <option>GET</option><option>POST</option><option>PUT</option><option>DELETE</option>
                                                </select>
                                                <input class="input" placeholder="https://…/{Id}" @bind="step.Url" @bind:event="oninput" />
                                            </div>
                                            <textarea class="debug-sql-editor" style="height:80px;resize:vertical"
                                                      placeholder="Body, t.ex. {JsonData}" spellcheck="false"
                                                      @bind="step.Body" @bind:event="oninput" />
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @if (_form.Steps.Count == 0)
                        {
                            <div style="color:var(--muted);font-size:11px;padding:4px 0">Inga steg — klicka ett objekt i verktygslådan för att lägga till.</div>
                        }
                    </div>
                </div>
            }
            else if (_selected is not null)
            {
                <div class="testfall-form-header">
                    <div>
                        <span style="font-weight:600;color:var(--blue)">#@_selected.DataSetId</span>
                        @if (!string.IsNullOrEmpty(_selected.Tag))
                        {
                            <span class="testfall-tag" style="margin-left:6px">@_selected.Tag</span>
                        }
                        <div style="font-size:12px;margin-top:2px">@_selected.Beskrivning</div>
                    </div>
                    <div style="display:flex;gap:6px;align-items:center">
                        <button class="btn sm primary" @onclick="() => RunOne(_selected)" disabled="@_busy">▶ Kör</button>
                        <button class="btn sm" @onclick="EditSelected">✎ Redigera</button>
                        <button class="btn sm danger" @onclick="DeleteSelected">🗑</button>
                    </div>
                </div>
                <div style="flex:1;overflow-y:auto;padding:10px 12px">
                    @if (_selected.Steps.Count > 0)
                    {
                        @for (int i = 0; i < _selected.Steps.Count; i++)
                        {
                            var step = _selected.Steps[i];
                            var num  = i + 1;
                            <div style="display:flex;align-items:center;gap:6px;padding:5px 0;border-bottom:1px solid var(--border)">
                                <span style="color:var(--muted);font-size:10px;min-width:18px;text-align:right">@num.</span>
                                <span class="action-type-badge @StepBadgeClass(step.Type)">@StepBadgeText(step.Type)</span>
                                <span style="font-size:11px;flex:1">@StepSummary(step)</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="color:var(--muted);font-size:12px">Inga steg definierade.</div>
                    }
                </div>
            }
            else
            {
                <div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--muted);font-size:12px">
                    Välj ett testfall i listan eller klicka + Nytt
                </div>
            }
        </div>
    </div>

    <!-- ── Status log ── -->
    @if (_log.Count > 0)
    {
        <div class="status-bar">
            <div class="status-bar-header">
                <span class="status-bar-title">
                    @if (_busy) { <span class="status-spinner">⟳</span> }
                    Körning
                </span>
                <button class="btn sm" @onclick="() => _log.Clear()">✕</button>
            </div>
            <div class="status-bar-log" id="testfall-log">
                @foreach (var line in _log)
                {
                    <div style="color:@LogColor(line)">@line</div>
                }
            </div>
        </div>
    }

</div>

@code {
    private record ToolboxScript(string Name, string RelativePath, string Path);

    private string       _filter       = "";
    private HashSet<int> _checked      = [];
    private TestCase?    _selected;
    private bool         _editMode;
    private bool         _isNew;
    private bool         _busy;
    private TestCase     _form         = new();
    private List<string> _log          = [];
    private int          _sleepSeconds = 2;
    private readonly CancellationTokenSource _cts = new();

    private List<ToolboxScript> _toolboxScripts   = [];
    private List<Scenario>      _toolboxScenarios = [];
    private HashSet<int>        _expandedSteps    = [];

    private bool   _newSqlOpen    = false;
    private string _newSqlName    = "";
    private string _newSqlContent = "";
    private bool   _newSwagOpen   = false;
    private string _newSwagName   = "";
    private string _newSwagMethod = "POST";
    private string _newSwagUrl    = "";
    private string _newSwagBody   = "";

    private string? _editSqlPath    = null;
    private string  _editSqlName    = "";
    private string  _editSqlContent = "";
    private string? _editSwagId     = null;
    private string  _editSwagName   = "";
    private string  _editSwagMethod = "POST";
    private string  _editSwagUrl    = "";
    private string  _editSwagBody   = "";

    private IEnumerable<TestCase> Filtered => Svc.Cases
        .Where(tc => string.IsNullOrEmpty(_filter)
            || tc.Beskrivning.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || tc.Tag.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || tc.DataSetId.ToString().Contains(_filter))
        .OrderBy(tc => tc.DataSetId);

    protected override void OnInitialized() { Svc.Load(); DataSvc.Load(); LoadToolbox(); }

    public async ValueTask DisposeAsync() { _cts.Cancel(); await Task.CompletedTask; }

    // ── Toolbox ────────────────────────────────────────────────────────────────

    private void LoadToolbox()
    {
        var root = Settings.Settings.DebugScriptsPath;
        if (!Directory.Exists(root)) return;

        _toolboxScripts = Directory.GetFiles(root, "*.sql", SearchOption.AllDirectories)
            .OrderBy(f => f)
            .Select(f => new ToolboxScript(
                Name:         Path.GetFileNameWithoutExtension(f),
                RelativePath: Path.GetRelativePath(root, f),
                Path:         f))
            .ToList();

        var scenariosPath = Path.Combine(root, "scenarios.json");
        if (File.Exists(scenariosPath))
        {
            try
            {
                _toolboxScenarios = System.Text.Json.JsonSerializer.Deserialize<List<Scenario>>(
                    File.ReadAllText(scenariosPath)) ?? [];
            }
            catch { _toolboxScenarios = []; }
        }
    }

    private void SaveNewSql()
    {
        if (string.IsNullOrWhiteSpace(_newSqlName)) return;
        var root = Settings.Settings.DebugScriptsPath;
        if (!Directory.Exists(root)) return;
        var safe = string.Concat(_newSqlName.Trim().Split(Path.GetInvalidFileNameChars()));
        File.WriteAllText(Path.Combine(root, safe + ".sql"), _newSqlContent);
        CancelNewSql();
        LoadToolbox();
    }

    private void CancelNewSql() { _newSqlOpen = false; _newSqlName = ""; _newSqlContent = ""; }

    private void SaveNewSwagger()
    {
        if (string.IsNullOrWhiteSpace(_newSwagName) || string.IsNullOrWhiteSpace(_newSwagUrl)) return;
        var root = Settings.Settings.DebugScriptsPath;
        if (!Directory.Exists(root)) return;
        _toolboxScenarios.Add(new Scenario { Name = _newSwagName, Method = _newSwagMethod, Url = _newSwagUrl, Body = _newSwagBody });
        var path = Path.Combine(root, "scenarios.json");
        File.WriteAllText(path, System.Text.Json.JsonSerializer.Serialize(
            _toolboxScenarios, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }));
        CancelNewSwagger();
    }

    private void CancelNewSwagger() { _newSwagOpen = false; _newSwagName = ""; _newSwagMethod = "POST"; _newSwagUrl = ""; _newSwagBody = ""; }

    private void StartEditSql(ToolboxScript s)
    {
        _editSqlPath    = s.Path;
        _editSqlName    = s.Name;
        _editSqlContent = File.Exists(s.Path) ? File.ReadAllText(s.Path) : "";
        _newSqlOpen     = false;
    }

    private void SaveEditSql()
    {
        if (_editSqlPath is null || string.IsNullOrWhiteSpace(_editSqlName)) return;
        var dir  = Path.GetDirectoryName(_editSqlPath)!;
        var safe = string.Concat(_editSqlName.Trim().Split(Path.GetInvalidFileNameChars()));
        var newPath = Path.Combine(dir, safe + ".sql");
        if (newPath != _editSqlPath && File.Exists(_editSqlPath))
            File.Delete(_editSqlPath);
        File.WriteAllText(newPath, _editSqlContent);
        CancelEditSql();
        LoadToolbox();
    }

    private void CancelEditSql() { _editSqlPath = null; _editSqlName = ""; _editSqlContent = ""; }

    private void StartEditSwagger(Scenario s)
    {
        _editSwagId     = s.Id;
        _editSwagName   = s.Name;
        _editSwagMethod = s.Method;
        _editSwagUrl    = s.Url;
        _editSwagBody   = s.Body;
        _newSwagOpen    = false;
    }

    private void SaveEditSwagger()
    {
        if (_editSwagId is null) return;
        var s = _toolboxScenarios.FirstOrDefault(x => x.Id == _editSwagId);
        if (s is null) return;
        s.Name = _editSwagName; s.Method = _editSwagMethod; s.Url = _editSwagUrl; s.Body = _editSwagBody;
        var root = Settings.Settings.DebugScriptsPath;
        if (Directory.Exists(root))
            File.WriteAllText(Path.Combine(root, "scenarios.json"),
                System.Text.Json.JsonSerializer.Serialize(
                    _toolboxScenarios, new System.Text.Json.JsonSerializerOptions { WriteIndented = true }));
        CancelEditSwagger();
    }

    private void CancelEditSwagger() { _editSwagId = null; _editSwagName = ""; _editSwagMethod = "POST"; _editSwagUrl = ""; _editSwagBody = ""; }

    private void ToggleExpand(int idx)
    {
        if (!_expandedSteps.Remove(idx)) _expandedSteps.Add(idx);
    }

    private void AddDataRowStep(int dataSetId, string beskrivning) =>
        _form.Steps.Add(new TestCaseStep { Type = TestCaseStepType.TestfallData, DataSetId = dataSetId, Label = beskrivning });

    private void AddScriptStep(ToolboxScript script)
    {
        var content = File.Exists(script.Path) ? File.ReadAllText(script.Path) : "";
        _form.Steps.Add(new TestCaseStep { Type = TestCaseStepType.Sql, Label = script.Name, SqlScript = content });
        _expandedSteps.Add(_form.Steps.Count - 1);
    }

    private void AddScenarioStep(Scenario s)
    {
        _form.Steps.Add(new TestCaseStep { Type = TestCaseStepType.Swagger, Label = s.Name, HttpMethod = s.Method, Url = s.Url, Body = s.Body });
        _expandedSteps.Add(_form.Steps.Count - 1);
    }

    private void AddSqlForeachStep()
    {
        _form.Steps.Add(new TestCaseStep { Type = TestCaseStepType.SqlForeach, Label = "SQL → foreach HTTP", HttpMethod = "POST" });
        _expandedSteps.Add(_form.Steps.Count - 1);
    }

    private void AddSleepStep() =>
        _form.Steps.Add(new TestCaseStep { Type = TestCaseStepType.Sleep, SleepSeconds = _sleepSeconds, Label = $"Vänta {_sleepSeconds}s" });

    private void RemoveStep(int idx)
    {
        _form.Steps.RemoveAt(idx);
        _expandedSteps = _expandedSteps
            .Where(i => i != idx)
            .Select(i => i > idx ? i - 1 : i)
            .ToHashSet();
    }

    private void MoveStepUp(int idx)
    {
        if (idx <= 0) return;
        (_form.Steps[idx - 1], _form.Steps[idx]) = (_form.Steps[idx], _form.Steps[idx - 1]);
        _expandedSteps.Clear();
    }

    private void MoveStepDown(int idx)
    {
        if (idx >= _form.Steps.Count - 1) return;
        (_form.Steps[idx + 1], _form.Steps[idx]) = (_form.Steps[idx], _form.Steps[idx + 1]);
        _expandedSteps.Clear();
    }

    // ── Step helpers ───────────────────────────────────────────────────────────

    private static string StepBadgeClass(TestCaseStepType t) => t switch
    {
        TestCaseStepType.TestfallData => "data",
        TestCaseStepType.Sql         => "sql",
        TestCaseStepType.Swagger     => "swagger",
        TestCaseStepType.Sleep       => "sleep",
        TestCaseStepType.SqlForeach  => "foreach",
        _                            => "",
    };

    private static string StepBadgeText(TestCaseStepType t) => t switch
    {
        TestCaseStepType.TestfallData => "DATA",
        TestCaseStepType.Sql         => "SQL",
        TestCaseStepType.Swagger     => "HTTP",
        TestCaseStepType.Sleep       => "ZZZ",
        TestCaseStepType.SqlForeach  => "FOR",
        _                            => "?",
    };

    private static string StepSummary(TestCaseStep step) => step.Type switch
    {
        TestCaseStepType.TestfallData => $"#{step.DataSetId} {step.Label}",
        TestCaseStepType.Sql         => step.Label,
        TestCaseStepType.Swagger     => string.IsNullOrEmpty(step.Label) ? $"{step.HttpMethod} {step.Url}" : step.Label,
        TestCaseStepType.Sleep       => $"Vänta {step.SleepSeconds}s",
        TestCaseStepType.SqlForeach  => string.IsNullOrEmpty(step.Label) ? $"{step.HttpMethod} {step.Url}" : step.Label,
        _                            => step.Label,
    };

    // ── Selection ──────────────────────────────────────────────────────────────

    private void Select(TestCase tc)
    {
        if (_editMode) return;
        _selected = _selected == tc ? null : tc;
    }

    private void Toggle(int id, bool on)
    {
        if (on) _checked.Add(id); else _checked.Remove(id);
    }

    private void CheckAll()     => _checked = Filtered.Select(tc => tc.DataSetId).ToHashSet();
    private void ClearChecked() => _checked.Clear();

    // ── Edit ───────────────────────────────────────────────────────────────────

    private void StartNew()
    {
        _form          = new TestCase();
        _isNew         = true;
        _editMode      = true;
        _selected      = null;
        _expandedSteps.Clear();
    }

    private void EditSelected()
    {
        if (_selected is null) return;
        _form = new TestCase
        {
            DataSetId   = _selected.DataSetId,
            Beskrivning = _selected.Beskrivning,
            Tag         = _selected.Tag,
            Steps       = _selected.Steps.Select(s => new TestCaseStep
            {
                Type         = s.Type,
                Label        = s.Label,
                DataSetId    = s.DataSetId,
                SqlScript    = s.SqlScript,
                HttpMethod   = s.HttpMethod,
                Url          = s.Url,
                Body         = s.Body,
                SleepSeconds = s.SleepSeconds,
            }).ToList(),
        };
        _isNew    = false;
        _editMode = true;
        _expandedSteps.Clear();
    }

    private void SaveForm()
    {
        if (_isNew)
            Svc.Add(_form);
        else if (_selected is not null)
        {
            Svc.Replace(_selected, _form);
            _selected = _form;
        }
        _editMode = false;
    }

    private void CancelEdit() { _editMode = false; _expandedSteps.Clear(); }

    private void DeleteSelected()
    {
        if (_selected is null) return;
        Svc.Remove(_selected);
        _checked.Remove(_selected.DataSetId);
        _selected = null;
    }

    // ── Run ────────────────────────────────────────────────────────────────────

    private async Task RunOne(TestCase tc)  => await Execute([tc]);
    private async Task RunSelected()        => await Execute(Filtered.Where(tc => _checked.Contains(tc.DataSetId)).ToList());

    private async Task Execute(IList<TestCase> cases)
    {
        _log.Clear();
        _busy = true;
        Log($"──── Kör {cases.Count} testfall ────");
        await InvokeAsync(StateHasChanged);

        try
        {
            await Svc.RunAsync(cases, Settings.Settings.SqlConnectionString,
                msg => _ = LogAsync(msg), _cts.Token);
            Log("──── Klar ─────────────────────────────");
        }
        catch (OperationCanceledException) { Log("  Avbruten"); }
        catch (Exception ex)               { Log($"  FEL: {ex.Message}"); }

        _busy = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Log(string msg)
    {
        _log.Add(msg);
        if (_log.Count > 500) _log.RemoveAt(0);
    }

    private async Task LogAsync(string msg)
    {
        await InvokeAsync(() => { Log(msg); StateHasChanged(); });
        try { await JS.InvokeVoidAsync("scrollToBottom", "testfall-log", _cts.Token); } catch { }
    }

    private static string LogColor(string line)
    {
        if (line.StartsWith("────")) return "var(--muted)";
        if (line.Contains("FEL:"))  return "var(--red)";
        if (line.Contains("OK"))    return "var(--green)";
        return "var(--text)";
    }

    // ── Export ─────────────────────────────────────────────────────────────────

    private async Task ExportSelected()
    {
        var cases = Filtered.Where(tc => _checked.Contains(tc.DataSetId)).ToList();
        var sql   = Svc.ExportSql(cases);
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", sql); } catch { }
        Log($"──── Exporterade {cases.Count} testfall till urklipp ────");
    }
}
